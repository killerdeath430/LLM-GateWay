# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# Provider keys are read only from the environment and must never appear in logs,
# errors or responses (decision D8).

# Server
PORT=8080
HOST=127.0.0.1

# Providers
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Postgres (local Docker, Unit 0.2)
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5432/gateway
